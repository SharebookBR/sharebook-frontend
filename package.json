{
  "name": "frontend",
  "version": "v4.5.0",
  "description": "It's just a getting started of front end sharebook application",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SharebookBR/frontend.git"
  },
  "keywords": [
    "sharebook",
    "sharebook-angular-13"
  ],
  "author": "Caique Vallim Araujo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SharebookBR/frontend/issues"
  },
  "homepage": "https://github.com/SharebookBR/frontend#readme",
  "scripts": {
    "ng": "ng",
    "start": "node ./node_modules/@angular/cli/bin/ng run angular:serve-ssr --configuration production",
    "start-local": "ng serve --configuration=local",
    "build-dev": "ng build",
    "build-stg": "ng build --configuration=stage",
    "build-prod": "ng build --configuration=production",
    "test-debug": "ng test --browsers ChromeDebug",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadlessCI",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "docker-dev": "ng build && docker image build -t sharebook .",
    "dev:ssr": "node ./node_modules/@angular/cli/bin/ng run angular:serve-ssr",
    "serve:ssr": "node dist/angular/server/main.js",
    "build:ssr": "node ./node_modules/@angular/cli/bin/ng build --configuration production && node ./node_modules/@angular/cli/bin/ng run angular:server",
    "prerender": "node ./node_modules/@angular/cli/bin/ng run angular:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/cdk": "^15.2.9",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/localize": "^15.2.10",
    "@angular/material": "^15.2.9",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/platform-server": "^15.2.10",
    "@angular/router": "^15.2.10",
    "@nguniversal/builders": "^15.2.1",
    "@nguniversal/express-engine": "^15.2.1",
    "@types/canvas-confetti": "^1.9.0",
    "bootstrap": "^4.5.0",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "core-js": "^2.5.4",
    "easymde": "^2.21.0",
    "express": "^4.22.2",
    "moment-timezone": "^0.5.39",
    "ng-recaptcha": "^11.0.0",
    "ngx-image-cropper": "^6.3.4",
    "ngx-image2dataurl": "^13.0.0",
    "ngx-mask": "^13.1.1",
    "ngx-toastr": "^14.3.0",
    "rxjs": "~6.6.7",
    "rxjs-compat": "^6.2.1",
    "tslib": "^2.4.1",
    "zone.js": "~0.12.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular/cli": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@angular/language-service": "^15.2.10",
    "@types/express": "^4.17.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "husky": "^0.14.3",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.16",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "puppeteer": "^24.38.0",
    "ts-node": "~7.0.0",
    "tslint": "~6.1.0",
    "typescript": "~4.8.4"
  },
  "overrides": {
    "minimatch": "3.1.4",
    "postcss": "8.5.23",
    "ws": "8.21.0"
  }
}